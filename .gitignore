node_modules/
__pycache__/
migrations/
# ai_chavruta is the one app with real persisted Postgres models (the Shas
# vector index) — its migrations need to ship to Docker/K8s to actually
# create that table/extension, unlike every other app here.
!ai_chavruta/migrations/
!ai_chavruta/migrations/*.py
static/js/
node/coverage/
venv/

.env
k8s/secrets.yaml
*.sqlite3
settings.py
__init__.py
manage.py
fix.py

# The bare __init__.py rule above matches anywhere, including inside
# ai_chavruta/migrations/ — but Django's migration loader requires that
# directory to be a real package (checks __file__, which namespace
# packages lack), so it needs to win over the blanket rule above it.
!ai_chavruta/migrations/__init__.py

# npm lockfile intentionally not committed (see bc7605addd5976746744fe49332d266df01b9d6d) —
# CI and Docker both use `npm install`, not `npm ci`
node/package-lock.json